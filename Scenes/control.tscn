[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends Label

@onready var init_time: float = Time.get_ticks_msec()

func _process(_delta: float) -> void:
	if (Time.get_ticks_msec() - init_time)/100 + 900 < 1000:
		text = \"0\" + str(((Time.get_ticks_msec() - init_time)/100 + 900)).pad_decimals(0)
	else:
		text = str(((Time.get_ticks_msec() - init_time)/100 + 900)).pad_decimals(0)
	text = text.insert(2, \":\")
	
	if (Time.get_ticks_msec() - init_time)/100 > 800:
		get_tree().change_scene_to_file(\"res://Scenes/game_over.tscn\")
"

